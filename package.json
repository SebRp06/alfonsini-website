{
  "name": "alfonsini-website",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda en línea de calzado Alfonsini. Construido por AccedIT bajo HCQE™, UFF™, HSS™ y GWT™.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "STATIC_EXPORT=1 next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "placeholders": "tsx scripts/generar-placeholders.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
